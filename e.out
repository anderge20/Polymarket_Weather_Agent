  <div class="modal fade" id="portalTrafficModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title fw-semibold mb-0"><i class="bi bi-graph-up-arrow me-2 text-secondary"></i>Traffic Statistics</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-4">
          <p class="text-muted small mb-3">Active connections and data transfer rates over the last 24 hours (times in UTC). Use this to identify quieter periods for optimal throughput.</p>
          <div id="portalTrafficChartArea">
            <canvas id="portalTrafficChart" style="max-height:300px"></canvas>
          </div>
          <div id="portalTrafficLoading" class="text-center text-muted py-4"><i class="bi bi-hourglass-split me-1"></i>Loading…</div>
          <div id="portalTrafficError" class="alert alert-warning mt-2" style="display:none"></div>
          <div id="portalScheduleArea"></div>
        </div>
      </div>
    </div>
  </div>
  <script>
  (function(){
    var schedStr = '', maxConn = '750';
    if (!schedStr || schedStr === 'none' || !maxConn) return;
    var defaultLimit = parseInt(maxConn);
    var segments = [];
    schedStr.split(',').forEach(function(entry) {
      var m = entry.trim().match(/^(\d{1,2}):(\d{2})-(\d{1,2}):(\d{2})=(\d+)$/);
      if (!m) return;
      segments.push({
        startMin: parseInt(m[1])*60+parseInt(m[2]),
        endMin:   parseInt(m[3])*60+parseInt(m[4]),
        limit:    parseInt(m[5]),
        isDefault: false
      });
    });
    if (!segments.length) return;
    // Fill gaps between scheduled entries with the default maxConnections value
    segments.sort(function(a,b){return a.startMin-b.startMin;});
    var allSegments = [], cursor = 0, totalMin = 24*60;
    segments.forEach(function(s) {
      if (s.startMin > cursor)
        allSegments.push({startMin: cursor, endMin: s.startMin, limit: defaultLimit, isDefault: true});
      allSegments.push(s);
      cursor = s.endMin;
    });
    if (cursor < totalMin)
      allSegments.push({startMin: cursor, endMin: totalMin, limit: defaultLimit, isDefault: true});
    var maxLimit = Math.max.apply(null, allSegments.map(function(s){return s.limit;}));
    function segColor(limit) {
      var ratio = limit / maxLimit;
      if (ratio >= 0.8) return '#198754';
      if (ratio >= 0.5) return '#ffc107';
      if (ratio >= 0.2) return '#fd7e14';
      return '#dc3545';
    }
    function fmtMin(m) {
      return ('0'+Math.floor(m/60)).slice(-2)+':'+('0'+(m%60)).slice(-2);
    }
    var nowUtcMin = (function(){
      var d = new Date();
      return d.getUTCHours()*60+d.getUTCMinutes();
    })();
    var html = '<div class="mt-4 pt-3 border-top">'
      + '<div class="d-flex justify-content-between align-items-center mb-1">'
      + '<span class="text-muted fw-semibold" style="font-size:0.78rem;"><i class="bi bi-clock me-1"></i>Max connections schedule (UTC)</span>'
      + '<span class="text-muted" style="font-size:0.72rem;">Current time: <strong>' + fmtMin(nowUtcMin) + ' UTC</strong></span>'
      + '</div>'
      + '<div style="position:relative;">'
      + '<div style="position:relative;height:28px;border-radius:6px;overflow:hidden;border:1px solid var(--bs-border-color);">';
    allSegments.forEach(function(s) {
      var widthPct = (s.endMin - s.startMin) / totalMin * 100;
      var leftPct  = s.startMin / totalMin * 100;
      var title = fmtMin(s.startMin)+'\u2013'+fmtMin(s.endMin)+' UTC: max '+s.limit+' connections'+(s.isDefault?' (default)':'');
      html += '<div title="'+title+'"'
        + ' style="position:absolute;left:'+leftPct+'%;width:'+widthPct+'%;height:100%;background:'+segColor(s.limit)
        + ';opacity:'+(s.isDefault?'0.45':'0.85')+';display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:600;color:#fff;overflow:hidden;cursor:default;">'
        + s.limit + '</div>';
    });
    var nowPct = nowUtcMin / totalMin * 100;
    html += '</div>'
      + '<div style="position:absolute;left:'+nowPct+'%;top:0;height:100%;width:4px;background:#fff;box-shadow:-1px 0 0 rgba(0,0,0,0.5),1px 0 0 rgba(0,0,0,0.5),0 0 6px rgba(0,0,0,0.4);transform:translateX(-50%);cursor:default;z-index:2;" title="Current time: '+fmtMin(nowUtcMin)+' UTC"></div>'
      + '</div>'
      + '<div class="d-flex justify-content-between mt-1" style="font-size:0.68rem;color:var(--bs-secondary-color);">'
      + '<span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span>'
      + '</div>'
      + '<div class="d-flex flex-wrap gap-2 mt-2" style="font-size:0.72rem;">';
    allSegments.forEach(function(s) {
      html += '<span style="display:inline-flex;align-items:center;gap:4px;'+(s.isDefault?'opacity:0.65;':'')+'">'
        + '<span style="width:10px;height:10px;border-radius:2px;background:'+segColor(s.limit)+';display:inline-block;'+(s.isDefault?'outline:1px dashed currentColor;outline-offset:-2px;':'')+'">'
        + '</span>'
        + fmtMin(s.startMin)+'\u2013'+fmtMin(s.endMin)+': <strong>'+s.limit+'</strong>'+(s.isDefault?' <em class="text-muted">(default)</em>':'')
        + '</span>';
    });
    html += '</div></div>';
    document.getElementById('portalScheduleArea').innerHTML = html;
  })();
  </script>

  <div id="bottomfooter" class="bottomfooter d-flex align-items-center justify-content-between text-white px-3"
       style="background-color: dodgerblue; height:34px; border-top:1px solid rgba(255,255,255,0.15);">

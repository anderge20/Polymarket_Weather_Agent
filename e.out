<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>(function(){var t=localStorage.getItem('ecpds-theme');if(t)document.documentElement.setAttribute('data-bs-theme',t);}());</script>
  <title>ECMWF Free & Open Data Portal</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/datatables/css/dataTables.bootstrap5.min.css">
  <style>
    body { padding-top: 85px; padding-bottom: 44px; min-height: 100vh; }
    .topheader {
      position: fixed; z-index: 1030; top: 0; left: 0; width: 100%; margin: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.30);
    }
    #topheader .container-fluid { flex-wrap: nowrap !important; }
    .header_nav_divider {
      display: inline-block; width: 1px; height: 22px;
      background: rgba(255,255,255,0.3); margin: 0 0.3rem; flex-shrink: 0;
    }
    .header_simple_title {
      font-size: 0.75rem; font-weight: 600; letter-spacing: 0.025em;
      color: rgba(255,255,255,0.95);
      background: rgba(255,255,255,0.13); border: 1px solid rgba(255,255,255,0.22);
      border-radius: 20px; padding: 0.18rem 0.7rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      flex: 0 1 auto; min-width: 0; max-width: 40%;
    }
    .location_simple {
      padding: 4px 14px; background: rgba(255,255,255,0.12);
      border-top: 1px solid rgba(255,255,255,0.18);
      border-bottom: 1px solid rgba(255,255,255,0.15);
      font-size: 0.78rem; color: rgba(255,255,255,0.7);
      display: flex; align-items: center; justify-content: space-between;
    }
    .location_simple .btn-about {
      color: rgba(255,255,255,0.55); background: none; border: none; padding: 0 2px;
      line-height: 1; cursor: pointer; flex-shrink: 0;
    }
    .location_simple .btn-about:hover { color: #fff; }
    .location_simple .breadcrumb {
      margin: 0; padding: 0; background: transparent;
      font-size: 0.78rem; flex-wrap: nowrap; overflow: hidden;
    }
    .location_simple .breadcrumb-item { color: rgba(255,255,255,0.7); white-space: nowrap; }
    .location_simple .breadcrumb-item + .breadcrumb-item::before {
      content: "›"; color: rgba(255,255,255,0.4); font-size: 1rem; line-height: 1; vertical-align: middle;
    }
    .location_simple .breadcrumb-item a { color: rgba(255,255,255,0.82); text-decoration: none; }
    .location_simple .breadcrumb-item a:hover { color: #fff; text-decoration: underline; }
    .location_simple .breadcrumb-item.active { color: #fff; font-weight: 500; }
    .bottomfooter {
      position: fixed; z-index: 1030; bottom: 0; left: 0; width: 100%; margin: 0;
    }
    .footer_simple_title {
      font-size: 0.78rem; color: rgba(255,255,255,0.85);
      font-family: "Open Sans","Helvetica Neue",Helvetica,Arial,sans-serif;
    }
    .footer_simple_title a { color: #fff; text-decoration: none; font-weight: 600; }
    .footer_simple_title a:hover { color: #fff; text-decoration: underline; }
    /* Subtle column separators */
    table.dataTable td + td, table.dataTable th + th { border-left: 1px solid rgba(0,0,0,0.08); }
    /* DataTables thead light mode */
    table.dataTable thead > tr > th { white-space: nowrap; border-bottom: 2px solid var(--bs-border-color) !important; }
    /* DT2: right-align header title text in flex container */
    table.dataTable thead th.text-end .dt-column-title { justify-content: flex-end; }
    /* DataTables thead dark mode */
    [data-bs-theme=dark] thead.table-light > tr > th,
    [data-bs-theme=dark] thead.table-light > tr > td,
    [data-bs-theme=dark] table.dataTable thead > tr > th {
      background-color: var(--bs-secondary-bg) !important;
      color: var(--bs-body-color) !important;
      border-bottom: 2px solid var(--bs-border-color-translucent) !important;
    }
    /* DataTables info text style, matching monitor */
    div.dt-container .dt-info { padding-top: 0 !important; font-size: 0.875rem; color: var(--bs-secondary-color, #6c757d); }
    div.dt-container .d-flex.mt-2 { align-items: flex-start !important; }
    /* Left-align empty-table message */
    table.dataTable td.dt-empty { text-align: left !important; }
    /* Hide pagination when all rows fit on one page */
    .dt-paging:not(:has(li.dt-paging-button:not(.active):not(.disabled))) { display: none !important; }
    /* Sort icon: inline after title text (same as monitor ecpds.css lines 1249-1276) */
    table.dataTable thead > tr > th span.dt-column-order::before,
    table.dataTable thead > tr > th span.dt-column-order::after { opacity: 0.45 !important; }
    table.dataTable thead > tr > th.dt-ordering-asc span.dt-column-order::before,
    table.dataTable thead > tr > th.dt-ordering-desc span.dt-column-order::after { opacity: 0.9 !important; }
    table.dataTable thead > tr > th span.dt-column-order {
      position: relative !important; display: inline-block !important;
      right: auto !important; top: auto !important; bottom: auto !important;
      width: 12px !important; height: 1em; vertical-align: middle; margin-left: 3px;
    }
    table.dataTable thead > tr > th.dt-orderable-asc,
    table.dataTable thead > tr > th.dt-orderable-desc,
    table.dataTable thead > tr > th.dt-ordering-asc,
    table.dataTable thead > tr > th.dt-ordering-desc { padding-right: 0.5rem !important; }
    .listing-table td:first-child a { text-decoration: none; color: inherit; }
    /* Portal notice / warning bars */
    .portal-notice, .portal-warning {
      display: flex; align-items: flex-start; gap: 0.6rem;
      padding: 0.6rem 0.9rem; border-radius: 8px; font-size: 0.875rem;
      border: 1px solid var(--bs-border-color);
      background: var(--bs-secondary-bg); color: var(--bs-body-color);
      line-height: 1.5;
    }
    .portal-notice > i  { color: var(--bs-primary);  margin-top: 0.15rem; flex-shrink: 0; }
    .portal-warning > i { color: var(--bs-danger);   margin-top: 0.15rem; flex-shrink: 0; }
    .portal-warning { border-color: rgba(var(--bs-danger-rgb), 0.35); background: rgba(var(--bs-danger-rgb), 0.06); }
    .portal-notice a, .portal-warning a { color: inherit; text-decoration: underline; }
    .portal-notice a:hover, .portal-warning a:hover { opacity: 0.8; }
  </style>
</head>
<body>
  <nav id="topheader" class="topheader navbar py-0" style="background-color: dodgerblue;">
    <div class="container-fluid d-flex align-items-center px-3 py-2">
      <a class="navbar-brand p-0 me-0 flex-shrink-0" href="/">
        <img src="/images/logo.production.png" alt="ECPDS" width="140" height="24" style="display:block;">
      </a>
      <span class="header_simple_title d-none d-sm-block ms-2">ECMWF Free & Open Data Portal</span>
      <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
        <a id="loginBtn" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1 px-2 d-none"
           href="/ecpds/logout" title="Sign in with a different account"
           style="height:28px;">
          <i class="bi bi-box-arrow-in-right" style="font-size:0.85rem;"></i>
          <span class="d-none d-sm-inline" style="font-size:0.8rem;">Login</span>
        </a>
        <span class="header_nav_divider d-none"></span>
        <button id="btnTheme" class="btn btn-sm btn-outline-light p-1 lh-1"
                onclick="ecpdsToggleTheme()" title="Toggle light/dark theme"
                style="width:28px;height:28px;">
          <i id="themeIcon" class="bi bi-moon-fill" style="font-size:0.8rem;"></i>
        </button>
        <a class="btn btn-sm btn-outline-light p-1 lh-1 d-flex align-items-center justify-content-center"
           href="https://ecmwf.github.io/open-ecpds/" target="_blank" rel="noopener"
           title="OpenECPDS Documentation" style="width:28px;height:28px;">
          <i class="bi bi-book" style="font-size:0.85rem;"></i>
        </a>
        <button class="btn btn-sm btn-outline-light p-1 lh-1" style="width:28px;height:28px;"
                data-bs-toggle="offcanvas" data-bs-target="#portalHelpOffcanvas"
                title="Interface help">
          <i class="bi bi-question-circle" style="font-size:0.85rem;"></i>
        </button>
      </div>
    </div>
    <div class="w-100 location_simple" id="locationBar" data-base="/forecasts/">
      <div id="locationBreadcrumb"></div>
      <button class="btn-about" data-bs-toggle="modal" data-bs-target="#aboutModal" title="About OpenECPDS">
        <i class="bi bi-info-circle" style="font-size:0.85rem;"></i>
      </button>
    </div>
  </nav>

  <!-- About modal (must be outside the fixed <nav> to render at full z-index) -->
  <div class="modal fade" id="aboutModal" tabindex="-1" aria-labelledby="aboutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center px-4 pt-0 pb-4">
          <img src="/images/OpenECPDS.svg" alt="OpenECPDS" class="img-fluid mb-3" style="max-height:80px;">
          <p class="text-muted small mb-2">Our mission with OpenECPDS is to keep data moving!</p>
          <ul class="list-unstyled mb-0" style="font-size:0.82rem; line-height:2;">
            <li><span class="badge bg-primary bg-opacity-10 text-primary fw-normal px-2">Inspired by operational excellence</span></li>
            <li><span class="badge bg-primary bg-opacity-10 text-primary fw-normal px-2">Powered by open-source innovation</span></li>
            <li><span class="badge bg-success bg-opacity-10 text-success fw-normal px-2">Acquire from anywhere</span></li>
            <li><span class="badge bg-success bg-opacity-10 text-success fw-normal px-2">Deliver everywhere</span></li>
            <li><span class="badge bg-info bg-opacity-10 text-info fw-normal px-2">Connect with confidence</span></li>
            <li><span class="badge bg-info bg-opacity-10 text-info fw-normal px-2">Share without limits</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Connection info modal -->
  <div class="modal fade" id="connectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h6 class="modal-title fw-semibold mb-0"><i class="bi bi-book me-2 text-primary"></i>Access Guide</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body px-4 pb-4">
          <div class="row g-3">
            <div id="connectHttpsCol" class="col-md-6">
              <div class="card h-100 border-primary border-opacity-25">
                <div class="card-header py-2 bg-primary bg-opacity-10">
                  <i class="bi bi-shield-lock-fill me-1 text-primary"></i><strong class="small">HTTPS</strong>
                </div>
                <div class="card-body small">
                  <p class="text-muted mb-2">Browse and download files via web browser or any HTTP client.</p>
                  <div class="text-muted mb-1">Your home directory URL</div>
                  <code id="connectHttpsUrl" class="d-block bg-body-secondary rounded px-2 py-1 mb-3 user-select-all"></code>
                  <div class="text-muted mb-1">curl examples <span class="fw-normal">(replace <em>DIR</em>, <em>FILE</em>)</span></div>
                  <div id="connectHttpsExamples"></div>
                  <p class="text-muted mt-1 mb-2" style="font-size:0.72rem;"><i class="bi bi-info-circle me-1"></i>Add <code>-k</code> to skip TLS certificate verification — only if using a self-signed certificate, but this is not secure.</p>
                  <div class="mt-2 border-top pt-2">
                    <p class="text-muted mb-1" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:.05em;">Advanced usage</p>
                    <a class="small text-muted text-decoration-none d-block mb-1" data-bs-toggle="collapse" href="#httpsFormats" role="button" aria-expanded="false" aria-controls="httpsFormats" style="cursor:pointer;">
                      <i class="bi bi-chevron-right me-1" style="font-size:0.7rem;transition:transform .2s;" id="httpsFormatsChevron"></i>Structured listing formats
                    </a>
                    <div class="collapse" id="httpsFormats">
                      <p class="text-muted mb-1" style="font-size:0.72rem;">Use the <code>Accept</code> header to request a specific format when listing a directory.</p>
                      <div id="connectHttpsFormats" class="mb-2"></div>
                    </div>
                    <a class="small text-muted text-decoration-none d-block" data-bs-toggle="collapse" href="#httpsParallel" role="button" aria-expanded="false" aria-controls="httpsParallel" style="cursor:pointer;">
                      <i class="bi bi-chevron-right me-1" style="font-size:0.7rem;transition:transform .2s;" id="httpsParallelChevron"></i>Byte-range &amp; parallel downloads
                    </a>
                    <div class="collapse" id="httpsParallel">
                      <p class="text-muted mt-1 mb-1" style="font-size:0.72rem;"><i class="bi bi-lightning-charge-fill me-1 text-warning"></i>The server honours HTTP <code>Range</code> requests — tools that split a download into parallel chunks will work and can significantly improve throughput. Each parallel connection counts as one session against your limit, so keep the number of chunks below your maximum allowed sessions.</p>
                      <div id="connectHttpsParallel"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div id="connectS3Col" class="col-md-6">
              <div class="card h-100 border-warning border-opacity-25">
                <div class="card-header py-2 bg-warning bg-opacity-10">
                  <i class="bi bi-bucket-fill me-1 text-warning"></i><strong class="small">S3</strong>
                </div>
                <div class="card-body small">
                  <p class="text-muted mb-2">Use the AWS CLI, MinIO Client (mc), rclone, boto3, or s5cmd, or any other S3-compatible client that supports S3 endpoints such as /s3.</p>
                  <div class="text-muted mb-1">Endpoint URL</div>
                  <code id="connectS3Url" class="d-block bg-body-secondary rounded px-2 py-1 mb-2 user-select-all"></code>
                  <div class="text-muted mb-1" id="connectS3AnonLabel">AWS CLI examples <span class="fw-normal">(replace <em>DESTINATION</em>, <em>DIR</em>, <em>FILE</em>)</span></div>
                  <div id="connectS3Anon"></div>
                  <p id="connectS3AnonNote" class="text-muted mt-1 mb-2" style="font-size:0.72rem;"><i class="bi bi-info-circle me-1"></i>The bucket name is your username (<code>opendata</code>); destinations are the top-level path segments. Add <code>--no-verify-ssl</code> to skip TLS certificate verification — only if using a self-signed certificate.</p>
                  <div class="mt-2 border-top pt-2" id="s3Advanced">
                    <p class="text-muted mb-1" style="font-size:0.72rem;text-transform:uppercase;letter-spacing:.05em;">Advanced usage</p>
                    <a class="small text-muted text-decoration-none d-block mb-1" data-bs-toggle="collapse" href="#s3WriteExamples" role="button" aria-expanded="false" aria-controls="s3WriteExamples" style="cursor:pointer;">
                      <i class="bi bi-chevron-right me-1" style="font-size:0.7rem;transition:transform .2s;" id="s3WriteChevron"></i>Upload, sync &amp; delete
                    </a>
                    <div class="collapse" id="s3WriteExamples">
                      <div id="connectS3Write" class="mb-2"></div>
                    </div>
                    <a class="small text-muted text-decoration-none d-block" data-bs-toggle="collapse" href="#s3Boto3" role="button" aria-expanded="false" aria-controls="s3Boto3" style="cursor:pointer;" id="s3Boto3Link">
                      <i class="bi bi-chevron-right me-1" style="font-size:0.7rem;transition:transform .2s;" id="s3Boto3Chevron"></i>Python (boto3)
                    </a>
                    <div class="collapse" id="s3Boto3">
                      <div id="connectS3Python"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div id="connectFtpCol" class="col-md-6">
              <div class="card h-100 border-success border-opacity-25">
                <div class="card-header py-2 bg-success bg-opacity-10">
                  <i class="bi bi-hdd-network-fill me-1 text-success"></i><strong class="small">FTP</strong>
                </div>
                <div class="card-body small">
                  <p class="text-muted mb-2">Connect with any FTP client. Passive mode recommended.</p>
                  <div class="mb-1"><span class="text-muted">Host: </span><code id="connectFtpHost"></code></div>
                  <div class="mb-1"><span class="text-muted">Port: </span><code id="connectFtpPort"></code></div>
                  <div class="mb-1"><span class="text-muted">Username: </span><code>opendata</code></div>
                  <div class="mb-0"><span class="text-muted">Password: </span><span>any valid email address (e.g. <code>user@example.com</code>)</span></div>
                </div>
              </div>
            </div>
            <div id="connectSftpCol" class="col-md-6">
              <div id="sftpCard" class="card h-100 border-secondary border-opacity-25 opacity-50">
                <div class="card-header py-2 bg-secondary bg-opacity-10">
                  <i class="bi bi-lock-fill me-1 text-secondary"></i><strong class="small">SFTP</strong>
                  <span id="sftpBadge" class="badge bg-secondary fw-normal ms-2" style="font-size:0.7rem;">Not yet available</span>
                </div>
                <div id="sftpBody" class="card-body small text-muted">
                  <p class="mb-0">Secure FTP over SSH will be available in a future release.</p>
                </div>
              </div>
            </div>
            <div id="connectInfoCol" class="col-12">
              <div class="alert alert-secondary d-flex align-items-start gap-2 py-2 px-3 mb-0 small" role="alert" style="font-size:0.78rem;">
                <i class="bi bi-person-lock flex-shrink-0 mt-1"></i>
                <span>The files and directories visible to you are determined by the access rights configured for this account. Contact your system administrator if you believe you are missing access.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Portal public-URL overrides injected server-side (empty = use request-derived defaults) -->
  <div id="portalConfig" style="display:none"
    data-https-base=""
    data-s3-endpoint=""
    data-ftp-host=""
    data-ftp-port=""
    data-sftp-host=""
    data-sftp-port="22"
    data-s3-enabled="true"
    data-ftp-enabled="true"
    data-sftp-enabled="true"
    data-s3-can-write="false"
    data-s3-can-delete="false"></div>
  <script>
  (function() {
    // Rotate chevrons on Advanced usage sub-collapses
    [['httpsFormats', 'httpsFormatsChevron'], ['httpsParallel', 'httpsParallelChevron'], ['s3WriteExamples', 's3WriteChevron'], ['s3Boto3', 's3Boto3Chevron']].forEach(function(pair) {
      var el = document.getElementById(pair[0]);
      if (el) {
        el.addEventListener('show.bs.collapse', function() { var ch = document.getElementById(pair[1]); if (ch) ch.style.transform = 'rotate(90deg)'; });
        el.addEventListener('hide.bs.collapse', function() { var ch = document.getElementById(pair[1]); if (ch) ch.style.transform = 'rotate(0deg)'; });
      }
    });
    function copyBlock(container, lines, last) {
      var wrap = document.createElement('div');
      wrap.className = 'position-relative' + (last ? '' : ' mb-2');
      var pre = document.createElement('pre');
      pre.className = 'bg-body-secondary rounded px-2 py-2 mb-0';
      pre.style.cssText = 'font-size:0.72rem;white-space:pre;overflow-x:auto;padding-right:2rem;';
      pre.textContent = lines.join('\n');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn position-absolute top-0 end-0 mt-1 me-1 p-0 border-0 text-muted';
      btn.title = 'Copy to clipboard';
      btn.style.cssText = 'font-size:0.85rem;line-height:1;';
      btn.innerHTML = '<i class="bi bi-clipboard"></i>';
      btn.addEventListener('click', function() {
        navigator.clipboard.writeText(pre.textContent).then(function() {
          btn.innerHTML = '<i class="bi bi-clipboard-check text-success"></i>';
          setTimeout(function() { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
        });
      });
      wrap.appendChild(pre);
      wrap.appendChild(btn);
      container.appendChild(wrap);
    }
    var cfg = document.getElementById('portalConfig').dataset;
    var origin = window.location.protocol + '//' + window.location.host;
    var host = window.location.hostname;
    // Remove disabled protocol cards immediately (before any other JS touches them)
    if (cfg.s3Enabled === 'false') { var el = document.getElementById('connectS3Col'); if (el) el.remove(); }
    if (cfg.ftpEnabled === 'false') { var el = document.getElementById('connectFtpCol'); if (el) el.remove(); }
    if (cfg.sftpEnabled === 'false') { var el = document.getElementById('connectSftpCol'); if (el) el.remove(); }
    // Widen HTTPS card when it is the only visible protocol
    var siblingsVisible = ['connectS3Col','connectFtpCol','connectSftpCol'].some(function(id){ return !!document.getElementById(id); });
    if (!siblingsVisible) { var hc = document.getElementById('connectHttpsCol'); if (hc) { hc.classList.remove('col-md-6'); hc.classList.add('col-12'); } var ic = document.getElementById('connectInfoCol'); if (ic) { ic.classList.add('col-12'); } }
    // Use public-facing overrides when configured; otherwise derive from request.
    // When httpsBase is set it IS the user's public home directory URL, fully
    // replacing origin + '/forecasts/' (the LB rewrites the full prefix).
    var base = origin + '/ecpds/';
    var homeBase = cfg.httpsBase ? cfg.httpsBase.replace(/\/?$/, '/') : (base + 'home/opendata/');
    var s3Endpoint = cfg.s3Endpoint || (origin + '/s3');
    var ftpHost = cfg.ftpHost || host;
    var ftpPort = cfg.ftpPort || '21';
    document.getElementById('connectHttpsUrl').textContent = homeBase;
    var s3UrlEl = document.getElementById('connectS3Url'); if (s3UrlEl) s3UrlEl.textContent = s3Endpoint;
    var ftpHostEl = document.getElementById('connectFtpHost'); if (ftpHostEl) ftpHostEl.textContent = ftpHost;
    var ftpPortEl = document.getElementById('connectFtpPort'); if (ftpPortEl) ftpPortEl.textContent = ftpPort;
    var httpsEx = document.getElementById('connectHttpsExamples');
    copyBlock(httpsEx, ['# List a directory', 'curl ' + homeBase + 'DIR/']);
    copyBlock(httpsEx, ['# Download a file', 'curl \\', '  ' + homeBase + 'DIR/FILE -o FILE'], cfg.s3CanWrite !== 'true');
    if (cfg.s3CanWrite === 'true') {
      copyBlock(httpsEx, ['# Upload a file', 'curl -X POST \\', '  -H "Content-Type: application/octet-stream" \\', '  --data-binary @FILE \\', '  ' + homeBase + 'DIR/FILE'], true);
    }
    var fmtEx = document.getElementById('connectHttpsFormats');
    copyBlock(fmtEx, ['# List as JSON', 'curl \\', '  -H "Accept: application/json" \\', '  ' + homeBase + 'DIR/']);
    copyBlock(fmtEx, ['# List as CSV', 'curl \\', '  -H "Accept: text/csv" \\', '  ' + homeBase + 'DIR/']);
    copyBlock(fmtEx, ['# List as plain text, one name per line', 'curl \\', '  -H "Accept: text/plain" \\', '  ' + homeBase + 'DIR/'], true);
    var parEx = document.getElementById('connectHttpsParallel');
    copyBlock(parEx, ['# aria2c — 4 parallel connections (fastest for large files)', 'aria2c -x4 -s4 \\', '  ' + homeBase + 'DIR/FILE']);
    copyBlock(parEx, ['# axel — 4 parallel connections', 'axel -n4 ' + homeBase + 'DIR/FILE']);
    copyBlock(parEx, ['# curl byte-range resume / partial download', 'curl -C - \\', '  ' + homeBase + 'DIR/FILE -o FILE'], true);
    var s3AnonSection = document.getElementById('connectS3Anon');
    if (s3AnonSection) {
      var dest = 'EGS';
      var s3Write = document.getElementById('connectS3Write');
      var s3CanWrite = cfg.s3CanWrite === 'true';
      var s3CanDelete = cfg.s3CanDelete === 'true';
      if (dest) {
        // User is pinned to a single destination — files are directly at root of their bucket
        document.getElementById('connectS3AnonLabel').innerHTML = 'AWS CLI examples <span class="fw-normal">(replace <em>DIR</em>, <em>FILE</em>)</span>';
        document.getElementById('connectS3AnonNote').innerHTML = '<i class="bi bi-info-circle me-1"></i>Your bucket is <code>opendata</code> and you are connected directly to destination <code>' + dest + '</code>. Add <code>--no-verify-ssl</code> to skip TLS certificate verification — only if using a self-signed certificate.';
        copyBlock(s3AnonSection, ['# List files', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 ls s3://opendata/DIR/']);
        copyBlock(s3AnonSection, ['# Download a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 cp s3://opendata/DIR/FILE ./FILE']);
        copyBlock(s3AnonSection, ['# Download a directory (sync)', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 sync s3://opendata/DIR/ ./DIR/'], true);
        if (s3CanWrite) {
          copyBlock(s3Write, ['# Upload a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 cp ./FILE s3://opendata/DIR/FILE']);
          copyBlock(s3Write, ['# Upload a directory (sync)', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 sync ./DIR/ s3://opendata/DIR/'], !s3CanDelete);
        }
        if (s3CanDelete) {
          copyBlock(s3Write, ['# Delete a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 rm s3://opendata/DIR/FILE'], true);
        }
      } else {
        // User has access to multiple destinations — bucket name is username, then destination/path
        copyBlock(s3AnonSection, ['# List all destinations', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 ls s3://opendata/']);
        copyBlock(s3AnonSection, ['# List files in a destination', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 ls s3://opendata/DESTINATION/DIR/']);
        copyBlock(s3AnonSection, ['# Download a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 cp s3://opendata/DESTINATION/DIR/FILE ./FILE']);
        copyBlock(s3AnonSection, ['# Download a directory (sync)', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 sync s3://opendata/DESTINATION/DIR/ ./DIR/'], true);
        if (s3CanWrite) {
          copyBlock(s3Write, ['# Upload a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 cp ./FILE s3://opendata/DESTINATION/DIR/FILE']);
          copyBlock(s3Write, ['# Upload a directory (sync)', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 sync ./DIR/ s3://opendata/DESTINATION/DIR/'], !s3CanDelete);
        }
        if (s3CanDelete) {
          copyBlock(s3Write, ['# Delete a file', 'aws --no-sign-request --endpoint-url ' + s3Endpoint + ' \\', '  s3 rm s3://opendata/DESTINATION/DIR/FILE'], true);
        }
      }
      var s3Py = document.getElementById('connectS3Python');
      if (s3CanWrite) {
        copyBlock(s3Py, [
          'import boto3',
          'from botocore import UNSIGNED',
          'from botocore.config import Config',
          's3 = boto3.client(',
          '    "s3",',
          '    endpoint_url="' + s3Endpoint + '",',
          '    config=Config(signature_version=UNSIGNED),',
          ')',
          '# Upload a file',
          's3.upload_file("FILE", "opendata", "DIR/FILE")',
          '# Download a file',
          's3.download_file("opendata", "DIR/FILE", "FILE")',
        ], true);
      } else {
        var boto3Link = document.getElementById('s3Boto3Link');
        if (boto3Link) boto3Link.style.display = 'none';
      }
      if (!s3CanWrite && !s3CanDelete) {
        var s3Adv = document.getElementById('s3Advanced');
        if (s3Adv) s3Adv.style.display = 'none';
      }
    }
    var sftpPort = cfg.sftpPort || '9022';
    var sftpHost = cfg.sftpHost || host;
    var sftpCard = document.getElementById('sftpCard');
    if (sftpCard && ('9022' || sftpPort)) {
      sftpCard.classList.remove('opacity-50');
      sftpCard.classList.replace('border-secondary', 'border-info');
      sftpCard.querySelector('.card-header').classList.replace('bg-secondary', 'bg-info');
      sftpCard.querySelector('i').classList.replace('text-secondary', 'text-info');
      document.getElementById('sftpBadge').remove();
      var sftpBody = document.getElementById('sftpBody');
      sftpBody.classList.remove('text-muted');
      sftpBody.innerHTML =
        '<p class="text-muted mb-2">Connect using any SFTP/SCP client over SSH.</p>' +
        '<div class="mb-1"><span class="text-muted">Host: </span><code id="connectSftpHost"></code></div>' +
        '<div class="mb-1"><span class="text-muted">Port: </span><code>' + sftpPort + '</code></div>' +
        '<div class="mb-1"><span class="text-muted">Username: </span><code>opendata</code></div>' +
        '<div class="mb-0"><span class="text-muted">Password: </span>any valid email address (e.g. <code>user@example.com</code>)</div>';
      document.getElementById('connectSftpHost').textContent = sftpHost;
    }
  }());
  </script>

  <!-- Hidden carrier for the <a href="/forecasts/20260905/00z/ifs/0p25/">Parent Directory</a> link; extracted by JS below -->
  <div id="parentData" style="display:none"><a href="/forecasts/20260905/00z/ifs/0p25/">Parent Directory</a></div>

  <div class="container-xxl px-3 pt-2 pb-1 mx-auto">
    <div id="warning" class="portal-warning d-none mb-2"><i class="bi bi-exclamation-triangle-fill"></i><div>
To ensure the stability of our systems and to preserve resources for our
operational activities (network, compute, etc.), access to the open-data
portal is limited to <b>750</b> simultaneous connections. This limit helps
us guarantee reliable service for our operational users, especially during
periods of high demand.
For added reliability, the open-data is replicated across AWS, Azure, and
Google Cloud. If you experience difficulties accessing this portal directly,
you can also retrieve the data from these cloud platforms.
</div></div>
    <div id="msgTop" class="portal-notice d-none mb-2"><i class="bi bi-info-circle-fill"></i><div>For streamlined programmatic access, use our Python API: <a href='https://pypi.org/project/ecmwf-opendata/' target='blank'>ecmwf-opendata</a></div></div>

    <div class="card border-0 shadow-sm mt-2">
      <div class="card-header d-flex flex-wrap align-items-center gap-2" style="background:var(--bs-secondary-bg)">
        <i class="bi bi-folder2-open text-primary"></i>
        <span class="fw-semibold">Files</span>
        <script>
        (function(){
          var max='750', cur='506';
          if(max==='') return;
          var defaultMax = parseInt(max,10);
          // Apply schedule: find the effective max for the current UTC time
          var effectiveMax = defaultMax;
          var schedStr = '';
          if (schedStr && schedStr !== 'none') {
            var _now = new Date();
            var nowUtcMin = _now.getUTCHours()*60+_now.getUTCMinutes();
            schedStr.split(',').forEach(function(entry) {
              var m = entry.trim().match(/^(\d{1,2}):(\d{2})-(\d{1,2}):(\d{2})=(\d+)$/);
              if (!m) return;
              var sMin = parseInt(m[1])*60+parseInt(m[2]);
              var eMin = parseInt(m[3])*60+parseInt(m[4]);
              if (nowUtcMin >= sMin && nowUtcMin < eMin) effectiveMax = parseInt(m[5]);
            });
          }
          var curInt = cur==='' ? 0 : parseInt(cur,10);
          var displayCur = Math.max(1, Math.min(curInt, effectiveMax));
          var remaining = effectiveMax - displayCur;
          var html = '<span class="badge rounded-pill border fw-normal ms-1 '
            + (remaining<=0 ? 'bg-danger-subtle text-danger-emphasis' : remaining<=2 ? 'bg-warning-subtle text-warning-emphasis' : 'bg-secondary-subtle text-secondary-emphasis')
            + '" data-bs-toggle="popover" data-bs-placement="bottom" data-bs-trigger="hover focus" tabindex="0"'
            + ' data-bs-content="Number of active protocol sessions (HTTPS, S3, FTP, SFTP/SCP) for your account, against the configured maximum. A session is counted from authentication and released when it ends; short-lived operations such as individual S3 API calls open and close quickly. The counter is at least 1 while you are logged in. When the limit is reached, new connections will be refused."'
            + ' style="cursor:default">';
          if(cur!=='') html += '<i class="bi bi-plug me-1"></i>' + displayCur + '\u200a/\u200a' + effectiveMax;
          else html += '<i class="bi bi-plug me-1"></i>max\u00a0' + effectiveMax;
          html += '</span>';
          document.write(html);
        })();
        </script>
        <script>
        (function(){
          var maxUp='', curUp='', periodUp='';
          if(!maxUp) return;
          var maxBytes = parseInt(maxUp,10), curBytes = curUp==='' ? 0 : parseInt(curUp,10);
          var pct = maxBytes > 0 ? curBytes / maxBytes : 0;
          var remaining = maxBytes - curBytes;
          var colorCls = remaining<=0 ? 'bg-danger-subtle text-danger-emphasis'
            : pct>=0.9 ? 'bg-warning-subtle text-warning-emphasis'
            : 'bg-secondary-subtle text-secondary-emphasis';
          var period = parseInt(periodUp,10);
          var periodStr = period >= 1440 ? (period/1440).toFixed(0)+'d' : period >= 60 ? (period/60).toFixed(0)+'h' : period+'min';
          function fmtBytes(b) {
            if(b>=1099511627776) return (b/1099511627776).toFixed(1)+'TB';
            if(b>=1073741824) return (b/1073741824).toFixed(1)+'GB';
            if(b>=1048576) return (b/1048576).toFixed(1)+'MB';
            if(b>=1024) return (b/1024).toFixed(1)+'KB';
            return b+'B';
          }
          var html = '<span class="badge rounded-pill border fw-normal ms-1 ' + colorCls
            + '" data-bs-toggle="popover" data-bs-placement="bottom" data-bs-trigger="hover focus" tabindex="0"'
            + ' data-bs-content="Upload quota: bytes pushed to the portal in the last ' + periodStr
            + '. When the limit is reached, new connections will be refused."'
            + ' style="cursor:default"><i class="bi bi-upload me-1"></i>' ;
          if(curUp!=='') html += fmtBytes(curBytes) + '\u200a/\u200a' + fmtBytes(maxBytes);
          else html += fmtBytes(maxBytes) + '\u00a0max';
          html += '</span>';
          document.write(html);
        })();
        </script>
        <script>
        (function(){
          var maxDn='', curDn='', periodDn='';
          if(!maxDn) return;
          var maxBytes = parseInt(maxDn,10), curBytes = curDn==='' ? 0 : parseInt(curDn,10);
          var pct = maxBytes > 0 ? curBytes / maxBytes : 0;
          var remaining = maxBytes - curBytes;
          var colorCls = remaining<=0 ? 'bg-danger-subtle text-danger-emphasis'
            : pct>=0.9 ? 'bg-warning-subtle text-warning-emphasis'
            : 'bg-secondary-subtle text-secondary-emphasis';
          var period = parseInt(periodDn,10);
          var periodStr = period >= 1440 ? (period/1440).toFixed(0)+'d' : period >= 60 ? (period/60).toFixed(0)+'h' : period+'min';
          function fmtBytes(b) {
            if(b>=1099511627776) return (b/1099511627776).toFixed(1)+'TB';
            if(b>=1073741824) return (b/1073741824).toFixed(1)+'GB';
            if(b>=1048576) return (b/1048576).toFixed(1)+'MB';
            if(b>=1024) return (b/1024).toFixed(1)+'KB';
            return b+'B';
          }
          var html = '<span class="badge rounded-pill border fw-normal ms-1 ' + colorCls
            + '" data-bs-toggle="popover" data-bs-placement="bottom" data-bs-trigger="hover focus" tabindex="0"'
            + ' data-bs-content="Download quota: bytes pulled from the portal in the last ' + periodStr
            + '. When the limit is reached, new connections will be refused."'
            + ' style="cursor:default"><i class="bi bi-download me-1"></i>' ;
          if(curDn!=='') html += fmtBytes(curBytes) + '\u200a/\u200a' + fmtBytes(maxBytes);
          else html += fmtBytes(maxBytes) + '\u00a0max';
          html += '</span>';
          document.write(html);
        })();
        </script>
        <script>
        (function(){
          if('true'!=='false' && '750'!=='') {
            document.write('<button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="portalTrafficBtn" data-bs-toggle="modal" data-bs-target="#portalTrafficModal"><i class="bi bi-graph-up-arrow me-1"></i>Traffic</button>');
          }
        })();

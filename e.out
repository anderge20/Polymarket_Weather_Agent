          scales: {
            yConn: { type: 'linear', position: 'left', title: { display: true, text: 'Connections' }, beginAtZero: true },
            yBw: { type: 'linear', position: 'right', title: { display: true, text: 'Mbps' }, beginAtZero: true, grid: { drawOnChartArea: false } }
          }
        }
      });
    });

    // Alerts
    ['warning', 'msgTop', 'msgDown'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el && el.textContent.trim().length > 0)
        el.classList.remove('d-none');
    });

    // Build breadcrumb from window.location.pathname, stripping the base prefix
    (function() {
      var bar      = document.getElementById('locationBar');
      var base     = (bar.dataset.base || '/').replace(/\/$/, ''); // e.g. /ecpds/data/list
      var pathname = window.location.pathname.replace(/\/$/, '');  // strip trailing slash
      // Strip base prefix to get only the user-navigable sub-path
      var sub = pathname.indexOf(base) === 0 ? pathname.slice(base.length) : pathname;
      var segments = sub.replace(/^\//, '').split('/').filter(Boolean);
      var ol = document.createElement('ol');
      ol.className = 'breadcrumb';
      var home = document.createElement('li');
      home.className = 'breadcrumb-item';
      home.innerHTML = '<a href="' + base + '/"><i class="bi bi-house-fill"></i></a>';
      ol.appendChild(home);
      var acc = base + '/';
      for (var i = 0; i < segments.length; i++) {
        acc += segments[i] + '/';
        var li = document.createElement('li');
        if (i === segments.length - 1) {
          li.className = 'breadcrumb-item active';
          li.setAttribute('aria-current', 'page');
          li.textContent = segments[i];
        } else {
          li.className = 'breadcrumb-item';
          var a = document.createElement('a');
          a.href = acc;
          a.textContent = segments[i];
          li.appendChild(a);
        }
        ol.appendChild(li);
      }
      var nav = document.createElement('nav');
      nav.setAttribute('aria-label', 'breadcrumb');
      nav.appendChild(ol);
      document.getElementById('locationBreadcrumb').appendChild(nav);
    }());
    (function() {
      var carrier = document.getElementById('parentData');
      var btn = document.getElementById('parentBtn');
      var a = carrier ? carrier.querySelector('a') : null;
      if (a && btn) {
        btn.href = a.href;
        btn.classList.remove('disabled');
        btn.removeAttribute('aria-disabled');
      }
    }());

    // Page length — restore from localStorage
    var _savedLen = (function() {
      try { var v = parseInt(localStorage.getItem('portalPageLen'), 10); return [10,25,50,100,250].indexOf(v) >= 0 ? v : 25; } catch(e) { return 25; }
    })();
    document.getElementById('listingPageLen').value = _savedLen;

    var _table = $('#listingTable').DataTable({
      paging:       true,
      pageLength:   _savedLen,
      searching:    true,
      ordering:     true,
      info:         true,
      dom:          't<"d-flex align-items-start mt-2 px-3 pb-2"i<"ms-auto"p>>',
      language:     { info: 'Showing _START_ to _END_ of _TOTAL_ files', infoFiltered: '(filtered)', emptyTable: 'No files found.' },
      columnDefs:   [{ targets: [1, 2, 3], className: 'text-end' }]
    });

    $('#listingPageLen').on('change', function() {
      var len = +this.value;
      try { localStorage.setItem('portalPageLen', len); } catch(e) {}
      _table.page.len(len).draw();
    });
    $('#listingSearch').on('input', function() {
      _table.search(this.value).draw();
    });

    // Column visibility
    var _colModeKey       = 'portalColMode';
    var _customColsKey    = 'portalCustomCols';
    var _compactHide      = [3];
    var _colMode = (function() { try { return localStorage.getItem(_colModeKey) || 'auto'; } catch(e) { return 'auto'; } })();
    var _customCols = (function() {
      try { var s = localStorage.getItem(_customColsKey); if (s) return JSON.parse(s); } catch(e) {}
      return [0, 1, 2, 3];
    })();
    function _showCols(hideCols) {
      for (var i = 0; i < 4; i++)
        _table.column(i).visible(hideCols.indexOf(i) === -1, false);
      _table.columns.adjust();
    }
    function _applyCustomCols() {
      for (var i = 0; i < 4; i++)
        _table.column(i).visible(i === 0 ? true : _customCols.indexOf(i) !== -1, false);
      _table.columns.adjust();
    }
    function _syncChkBoxes() {
      document.querySelectorAll('.listing-col-chk').forEach(function(chk) {
        chk.checked = _customCols.indexOf(+chk.dataset.col) !== -1;
      });
    }
    document.querySelectorAll('.listing-col-chk').forEach(function(chk) {
      chk.addEventListener('change', function() {
        var col = +this.dataset.col;
        var idx = _customCols.indexOf(col);
        if (this.checked && idx === -1) _customCols.push(col);
        else if (!this.checked && idx !== -1) _customCols.splice(idx, 1);
        try { localStorage.setItem(_customColsKey, JSON.stringify(_customCols)); } catch(e) {}
        if (_colMode === 'custom') _applyCustomCols();
      });
    });
    function _applyResponsive() {
      if (_colMode !== 'auto') return;
      if (window.innerWidth < 576)      _showCols([1, 3]);
      else if (window.innerWidth < 768) _showCols([3]);
      else                              _showCols([]);
    }
    function _applyMode(mode) {
      var label = mode.charAt(0).toUpperCase() + mode.slice(1);
      $('#listingColModeBtn').html('<i class="bi bi-layout-three-columns me-1"></i>' + label);
      $('#listingColModeBtn').toggleClass('btn-outline-secondary', mode === 'auto').toggleClass('btn-primary', mode !== 'auto');
      $('#listingColModeBtn').closest('.dropdown').find('.dropdown-item').each(function() {
        $(this).find('i.bi-check').remove();
        if ($(this).data('listing-mode') === mode) $(this).prepend('<i class="bi bi-check me-1"></i>');
      });
      document.getElementById('listingCustomColChkPanel').style.display = (mode === 'custom') ? '' : 'none';
      if      (mode === 'auto')    _applyResponsive();
      else if (mode === 'all')     _showCols([]);
      else if (mode === 'compact') _showCols(_compactHide);
      else if (mode === 'custom')  { _syncChkBoxes(); _applyCustomCols(); }
    }
    $(window).on('resize', _applyResponsive);
    _applyMode(_colMode);
    $('#listingColModeBtn').closest('.dropdown').find('.dropdown-item').on('click', function(e) {
      e.preventDefault();
      var mode = $(this).data('listing-mode');
      if (!mode) return;
      _colMode = mode;
      try { localStorage.setItem(_colModeKey, mode); } catch(e) {}
      _applyMode(mode);
    });

    function ecpdsToggleTheme() {
      var t = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-bs-theme', t);
      localStorage.setItem('ecpds-theme', t);
      var ic = document.getElementById('themeIcon');
      if (ic) ic.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    }
    (function() {
      var t = document.documentElement.getAttribute('data-bs-theme') || 'light';
      var ic = document.getElementById('themeIcon');
      if (ic) ic.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    }());
  </script>

  <!-- Portal interface help offcanvas -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="portalHelpOffcanvas" aria-labelledby="portalHelpOffcanvasLabel"
       style="width:360px;max-width:95vw;">
    <div class="offcanvas-header border-bottom">
      <h6 class="offcanvas-title fw-semibold" id="portalHelpOffcanvasLabel">
        <i class="bi bi-question-circle me-2 text-primary"></i>Interface Help
      </h6>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body small" style="font-size:0.82rem;">

      <p class="text-muted mb-3">A quick reference for the Data Portal interface.</p>

      <!-- Theme toggle -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-circle-half me-1 text-secondary"></i>Light / Dark theme</div>
        <p class="text-muted mb-0">Click the <i class="bi bi-moon-fill"></i>&nbsp;/&nbsp;<i class="bi bi-sun-fill"></i> button in the top-right corner to switch between light and dark mode. Your preference is remembered across sessions.</p>
      </div>

      <!-- Breadcrumb navigation -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-signpost-split me-1 text-secondary"></i>Breadcrumb navigation</div>
        <p class="text-muted mb-0">The bar below the header shows your current location (e.g. <em>Home &rsaquo; folder &rsaquo; subfolder</em>). Click any segment to jump directly to that level. The <i class="bi bi-arrow-up-circle"></i> button on the right goes up one level.</p>
      </div>

      <!-- File browser -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-folder2-open me-1 text-primary"></i>Browsing files</div>
        <p class="text-muted mb-0">Click a <i class="bi bi-folder-fill text-warning"></i> folder to navigate into it. Click a <i class="bi bi-file-earmark"></i> file to download it directly to your browser.</p>
      </div>

      <!-- Search -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-search me-1 text-secondary"></i>Search</div>
        <p class="text-muted mb-0">Type in the <em>Search files&hellip;</em> box to filter the current directory listing in real time. The filter is case-insensitive and matches anywhere in the file name.</p>
      </div>

      <!-- Page size -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-list-ol me-1 text-secondary"></i>Page size</div>
        <p class="text-muted mb-0">The <i class="bi bi-list-ol"></i> selector next to the search box controls how many entries are shown per page. Use the pagination links at the bottom of the table to move between pages.</p>
      </div>

      <!-- Column visibility -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-layout-three-columns me-1 text-secondary"></i>Column visibility</div>
        <p class="text-muted mb-0">The <i class="bi bi-layout-three-columns"></i> dropdown lets you choose which columns are shown:
          <br>&bull; <strong>Auto</strong> &mdash; hides columns automatically on narrow screens.
          <br>&bull; <strong>All</strong> &mdash; always shows every column.
          <br>&bull; <strong>Compact</strong> &mdash; hides the ID column.
          <br>&bull; <strong>Custom</strong> &mdash; pick individual columns with checkboxes.
        </p>
      </div>

      <!-- Sorting -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-arrow-down-up me-1 text-secondary"></i>Sorting</div>
        <p class="text-muted mb-0">Click any column header to sort the listing. Click again to reverse the order. A third click removes the sort.</p>
      </div>

      <!-- Session badge -->
      <div class="mb-3" id="help-session-badge-section">
        <div class="fw-semibold mb-1"><i class="bi bi-plug me-1 text-secondary"></i>Session badge</div>
        <p class="text-muted mb-0">The <i class="bi bi-plug"></i> badge next to the <em>Traffic</em> button shows the number of active protocol sessions (HTTPS, S3, FTP, SFTP/SCP) for your account vs. the configured maximum. A session is counted from authentication and released when it ends; short-lived operations such as individual S3 API calls open and close quickly, so the counter may fluctuate. The value is always at least 1 while you are logged in. The badge turns yellow when capacity is nearly reached and red when the limit is hit &mdash; new connections will be refused until an existing one closes.</p>
      </div>

      <!-- Traffic button -->
      <div class="mb-3" id="help-traffic-section">
        <div class="fw-semibold mb-1"><i class="bi bi-graph-up-arrow me-1 text-secondary"></i>Traffic</div>
        <p class="text-muted mb-0">Click the <strong>Traffic</strong> button to open a chart showing active connections and upload/download rates for your account over the last 24 hours (times in UTC). Use it to identify quieter periods when the portal has less contention and transfers are likely to be faster.</p>
        <script>if('true'==='false'||'750'===''){var _tsb=document.getElementById('help-traffic-section');if(_tsb)_tsb.style.display='none';}</script>
      </div>

      <!-- Access Guide -->
      <div class="mb-3" id="help-access-guide-section">
        <div class="fw-semibold mb-1"><i class="bi bi-book me-1 text-primary"></i>Access Guide</div>
        <p class="text-muted mb-1">Click the <strong>Access Guide</strong> button to open connection instructions for all available protocols (HTTPS, S3, FTP, SFTP/SCP). Each card provides ready-to-use commands with a <i class="bi bi-clipboard"></i> copy button.</p>
        <div class="text-muted" style="font-size:0.78rem;">
          <div id="help-ep-https" class="mb-1"><i class="bi bi-globe me-1"></i><strong>HTTPS:</strong> <code></code></div>
          <div id="help-ep-s3" class="mb-1"><i class="bi bi-bucket me-1"></i><strong>S3:</strong> <code></code></div>
          <div id="help-ep-ftp" class="mb-1"><i class="bi bi-hdd-network me-1"></i><strong>FTP:</strong> <code>:</code></div>
          <div id="help-ep-sftp" class="mb-1"><i class="bi bi-lock me-1"></i><strong>SFTP:</strong> <code>:22</code></div>
        </div>
        <script>
          (function(){
            var hide = function(id){ var el=document.getElementById(id); if(el) el.style.display='none'; };
            if('false'==='false'){ hide('help-session-badge-section'); hide('help-access-guide-section'); return; }
            if(''==='') hide('help-ep-https');
            if('true'==='false'||''==='') hide('help-ep-s3');
            if('true'==='false'||''==='') hide('help-ep-ftp');
            if('true'==='false'||''==='') hide('help-ep-sftp');
          })();
        </script>
      </div>

      <!-- Notice banners -->
      <div class="mb-3">
        <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1 text-secondary"></i>Notice banners</div>
        <p class="text-muted mb-0">Blue information banners and orange warning banners may appear above or below the file listing. These are messages set by the system administrator &mdash; read them before downloading.</p>
      </div>

      <!-- About -->
      <div class="mb-0">
        <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1 text-secondary"></i>About</div>
        <p class="text-muted mb-0">Click the <i class="bi bi-info-circle"></i> icon at the right end of the breadcrumb bar to open the About panel for version and build information.</p>
      </div>

    </div>
  </div>
</body>
</html>

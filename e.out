      var labels = data.map(function(d){ return d.time.substring(11,16); });
      var conns  = data.map(function(d){ return d.connections; });
      var mbin   = data.map(function(d){ return d.durationIn  > 0 ? (d.bytesIn  * 8 / d.durationIn  / 1000).toFixed(3) : 0; });
      var mbout  = data.map(function(d){ return d.durationOut > 0 ? (d.bytesOut * 8 / d.durationOut / 1000).toFixed(3) : 0; });
      var ctx = document.getElementById('portalTrafficChart').getContext('2d');
      _portalTrafficChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            { label: 'Connections', data: conns, borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.08)', yAxisID: 'yConn', tension: 0.3, pointRadius: 2 },
